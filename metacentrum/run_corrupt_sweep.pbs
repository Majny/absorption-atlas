#!/bin/bash
#PBS -N abs_corrupt
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:gpu_mem=40gb:scratch_local=10gb
#PBS -l walltime=3:00:00
#PBS -j oe
set -uo pipefail
WORK=/storage/brno2/home/${USER}/absorption-atlas
export HF_HOME=$WORK/hf_cache MAMBA_ROOT_PREFIX=$WORK/mamba
[ -f "$WORK/.hf_token" ] && source "$WORK/.hf_token"
eval "$("$WORK/bin/micromamba" shell hook -s bash)"; micromamba activate abs
cd "$WORK/sae-spelling"; python "$WORK/run_corrupt_sweep.py" --fracs 0.0,0.25,0.5,0.75,0.9 --max-prompts 20; echo "rc=$?"
