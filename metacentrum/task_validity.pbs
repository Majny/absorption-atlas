#!/bin/bash
#PBS -N abs_taskval
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb:gpu_mem=40gb:scratch_local=10gb
#PBS -l walltime=1:00:00
#PBS -j oe
set -uo pipefail
WORK=/storage/brno2/home/${USER}/absorption-atlas
export HF_HOME=$WORK/hf_cache MAMBA_ROOT_PREFIX=$WORK/mamba
[ -f "$WORK/.hf_token" ] && source "$WORK/.hf_token"
eval "$("$WORK/bin/micromamba" shell hook -s bash)"; micromamba activate abs
cd "$WORK/sae-spelling"
python "$WORK/task_validity.py"
echo "rc=$?"
